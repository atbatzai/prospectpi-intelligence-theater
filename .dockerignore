# ProspectPI Intelligence Theater - Docker Build Optimization
# Exclude files and directories that don't need to be in the container

# Dependencies (will be installed in container)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Development files
*.log
.env.local
.env.development
.env.test
.DS_Store
Thumbs.db

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Test files
coverage/
__tests__/
*.test.js
*.test.ts
*.spec.js
*.spec.ts

# Build artifacts (will be generated in container)
dist/
build/
.next/

# Git
.git/
.gitignore
.gitattributes

# Docker files (don't need to copy into container)
Dockerfile*
docker-compose*.yml
.dockerignore

# Documentation
README.md
docs/
*.md

# CI/CD
.github/
.gitlab-ci.yml
Jenkinsfile

# Frontend specific
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.env.local

# Logs and temporary files
logs/
*.pid
*.seed
*.pid.lock
.npm/
.eslintcache

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
lib-cov/
coverage/
.nyc_output/

# Optional npm cache directory
.npm/

# Optional eslint cache
.eslintcache

# BMad core (development only)
.bmad-core/
.claude/
web-bundles/

# Test and demo files
*test*.js
*demo*.js
comprehensive-qa-test.js
performance-optimization-test.js
a-plus-validation-*.js

# Development scripts
start-dev.*
ecosystem.config.js

# Temporary files
temp/
tmp/