{
  "name": "prospectpi-intelligence-theater",
  "version": "1.0.0",
  "description": "Three-Agent Orchestration System for Intelligence Analysis",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:frontend\"",
    "dev:api": "ts-node -r tsconfig-paths/register src/server.ts",
    "dev:api:stable": "nodemon --exec \"ts-node -r tsconfig-paths/register\" src/server.ts --watch src --ignore src/**/*.test.ts --delay 2000ms",
    "dev:api:pm2": "pm2 start ecosystem.config.js --env development",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:frontend:stable": "cd frontend && npm run dev -- --no-open",
    "dev:both:stable": "concurrently --kill-others \"npm run dev:api:stable\" \"npm run dev:frontend:stable\"",
    "dev:demo": "ts-node -r tsconfig-paths/register src/index.ts",
    
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:dev": "docker-compose up --build",
    "docker:clean": "docker-compose down -v && docker system prune -f",
    "docker:prod": "docker-compose -f docker-compose.prod.yml up -d",
    
    "start": "node dist/index.js",
    "start:api": "node dist/server.js",
    "start:pm2": "pm2 start ecosystem.config.js --env production",
    "stop:pm2": "pm2 stop all && pm2 delete all",
    "restart:api": "pm2 restart prospectpi-api || npm run dev:api:pm2",
    "logs": "pm2 logs prospectpi-api",
    "health": "node scripts/health-check.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "type-check": "tsc --noEmit",
    "test:integration:existing-features": "jest --testPathPattern=tests/integration/existing-features",
    "test:performance:baseline": "jest --testPathPattern=tests/performance/baseline",
    "test:integration:salesforce": "jest --testPathPattern=tests/integration/salesforce",
    "test:integration:apis": "jest --testPathPattern=tests/integration/apis",
    "test:regression": "jest --testPathPattern=tests/regression",
    "test:all-safety": "npm run test:integration:existing-features && npm run test:performance:baseline && npm run test:regression",
    "db:migrate:test": "node scripts/test-migration.js",
    "db:rollback:test": "node scripts/test-rollback.js",
    "safety:check": "node scripts/brownfield-safety-check.js",
    "safety:comprehensive": "npm run safety:check && npm run test:all-safety && npm run lint && npm run type-check",
    "rollback:validate": "node scripts/validate-rollback.js",
    "deploy:staging": "npm run safety:comprehensive && echo 'Deploying to staging...'",
    "deploy:production": "npm run safety:comprehensive && echo 'Deploying to production...'",
    "monitor:health": "node scripts/health-check.js",
    "backup:db": "node scripts/backup-database.js"
  },
  "keywords": [
    "intelligence",
    "ai",
    "agents",
    "prospectpi"
  ],
  "author": "ProspectPI Development Team",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.3",
    "@types/pg": "^8.15.5",
    "axios": "^1.12.2",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.4.1",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-async-handler": "^1.2.0",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "openai": "^4.52.7",
    "pg": "^8.16.3",
    "rate-limiter-flexible": "^5.0.3",
    "sqlite3": "^5.1.6",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^10.0.0",
    "winston": "^3.13.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/preset-env": "^7.28.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.14.9",
    "@types/sqlite3": "^3.1.11",
    "@types/supertest": "^6.0.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^7.15.0",
    "@typescript-eslint/parser": "^7.15.0",
    "babel-jest": "^30.2.0",
    "concurrently": "^9.2.1",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "pm2": "^6.0.13",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
