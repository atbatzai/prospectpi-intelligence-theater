{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020", "DOM"],
    "types": ["node", "jest"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "removeComments": true,
    "noImplicitAny": true,
    "noImplicitReturns": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "exactOptionalPropertyTypes": false,
    "noImplicitOverride": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "baseUrl": "./src",
    "paths": {
      "@/*": ["*"],
      "@agents/*": ["agents/*"],
      "@services/*": ["services/*"],
      "@interfaces/*": ["interfaces/*"],
      "@config/*": ["config/*"]
    }
  },
  "include": [
    "src/models/**/*",
    "src/services/monitoring/**/*",
    "src/services/security/**/*",
    "src/services/privacy/**/*",
    "src/services/phase3-stubs.ts",
    "src/middleware/**/*",
    "src/agents/**/*",
    "src/config/**/*",
    "src/interfaces/**/*",
    "src/utils/**/*",
    "src/types/**/*",
    "src/app.ts",
    "src/server.ts",
    "src/index.ts",
    "src/routes/api/v1/phase3.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}