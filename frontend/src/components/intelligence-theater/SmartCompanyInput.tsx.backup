'use client';

import { useState, useEffect } from 'react';
import { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card';
import { Button } from '@/components/ui/button';
import { Input } from '@/components/ui/input';
import { Label } from '@/components/ui/label';
import { Textarea } from '@/components/ui/textarea';
import { Badge } from '@/components/ui/badge';
import { Search, Shield, Plus, X } from 'lucide-react';

// ProspectPI Research Input Interface - matches Lovable prompt specification
interface ProspectResearchInput {
  companyName: string;                    // Required
  companyUrl?: string;                    // Optional
  linkedinUrl?: string;                   // Optional  
  crmNotes?: string;                      // Optional - max 1000 chars
  organizationFocus?: string;             // Optional
  locationOfInterest?: string;            // Optional
  contextLinks?: string[];                // Optional - array of URLs
  additionalContext?: string;             // Optional - max 2000 chars
}

interface CompanyInputFormProps {
  onGenerate: (data: ProspectResearchInput) => void;
  isGenerating?: boolean;
}

export const SmartCompanyInput: React.FC<CompanyInputFormProps> = ({
  onGenerate,
  isGenerating = false
}) => {
  // Required Research Inputs from Lovable prompt
  const [companyName, setCompanyName] = useState('');
  const [companyUrl, setCompanyUrl] = useState('');
  const [linkedinUrl, setLinkedinUrl] = useState('');
  const [crmNotes, setCrmNotes] = useState('');
  const [organizationFocus, setOrganizationFocus] = useState('');
  const [locationOfInterest, setLocationOfInterest] = useState('');
  const [contextLinks, setContextLinks] = useState<string[]>(['']);
  const [additionalContext, setAdditionalContext] = useState('');
  // UI state
  const [showCompanyLogo, setShowCompanyLogo] = useState(false);

  // Sample companies for autocomplete
  const sampleCompanies = [
    'Snowflake', 'Databricks', 'MongoDB', 'Atlassian', 'ServiceNow', 
    'Stripe', 'Figma', 'Notion', 'Airtable', 'Microsoft', 'Apple', 'Tesla'
  ];

  // Auto-validate company name and show logo
  useEffect(() => {
    if (companyName.length > 2) {
      setShowCompanyLogo(sampleCompanies.some(company => 
        company.toLowerCase().includes(companyName.toLowerCase())
      ));
    } else {
      setShowCompanyLogo(false);
    }
  }, [companyName]);

  // Add new context link
  const addContextLink = () => {
    setContextLinks([...contextLinks, '']);
  };

  // Remove context link
  const removeContextLink = (index: number) => {
    setContextLinks(contextLinks.filter((_, i) => i !== index));
  };

  // Update context link
  const updateContextLink = (index: number, value: string) => {
    const updated = [...contextLinks];
    updated[index] = value;
    setContextLinks(updated);
  };

  const handleSubmit = (e: React.FormEvent) => {
    e.preventDefault();
    
    // Validate required company name
    if (!companyName.trim()) {
      return;
    }

    // Filter out empty context links
    const validContextLinks = contextLinks.filter(link => link.trim().length > 0);

    const researchInput: ProspectResearchInput = {
      companyName: companyName.trim(),
      companyUrl: companyUrl.trim() || undefined,
      linkedinUrl: linkedinUrl.trim() || undefined,
      crmNotes: crmNotes.trim() || undefined,
      organizationFocus: organizationFocus.trim() || undefined,
      locationOfInterest: locationOfInterest.trim() || undefined,
      contextLinks: validContextLinks.length > 0 ? validContextLinks : undefined,
      additionalContext: additionalContext.trim() || undefined,
    };

    onGenerate(researchInput);
  };



  return (
    <div className="w-full max-w-4xl mx-auto p-6 space-y-6">
      {/* ProspectPI Branded Header */}
      <div className="text-center mb-8">
        <div className="flex items-center justify-center gap-3 mb-2">
          <Shield className="h-8 w-8 text-violet-600" />
          <h1 className="text-3xl font-bold">
            <span className="text-navy-900">prospect</span>
            <span className="text-violet-600">PI</span>
          </h1>
        </div>
        <p className="text-lg text-gray-600">Business Intelligence Dossier Generation</p>
        <p className="text-sm text-gray-500">Professional intelligence software for enterprise sales teams</p>
      </div>

      <Card className="border-2 border-gray-200 shadow-xl">
        <CardHeader className="text-center bg-gradient-to-r from-navy-900 to-violet-600 text-white rounded-t-lg">
          <CardTitle className="text-2xl font-bold flex items-center justify-center gap-2">
            <Search className="h-6 w-6" />
            Clean Research Input Interface
          </CardTitle>
          <p className="text-violet-100 mt-2">
            Generate comprehensive intelligence dossiers for Fortune 500 prospects
          </p>
        </CardHeader>
        
        <CardContent className="p-8 space-y-6">
          <form onSubmit={handleSubmit} className="space-y-8">
            
            {/* 1. Prospect Company Name (Required) */}
            <div className="space-y-2">
              <Label htmlFor="companyName" className="text-base font-semibold text-gray-900">
                1. Prospect Company Name *
              </Label>
              <div className="relative">
                <Input
                  id="companyName"
                  type="text"
                  value={companyName}
                  onChange={(e) => setCompanyName(e.target.value)}
                  className="h-12 text-lg pl-4 pr-12 border-2 border-gray-300 focus:border-violet-500 focus:ring-violet-500"
                  placeholder="e.g., Snowflake, Databricks, MongoDB"
                  disabled={isGenerating}
                  required
                />
                <Search className="absolute right-4 top-1/2 transform -translate-y-1/2 h-5 w-5 text-gray-400" />
                {showCompanyLogo && (
                  <div className="mt-2 flex items-center text-sm text-green-600">
                    <Badge variant="outline" className="border-green-300 text-green-700">
                      ✓ Company recognized
                    </Badge>
                  </div>
                )}
              </div>
              <p className="text-sm text-gray-500">Large, prominent input for the target company to research</p>
            </div>

            {/* 2. Company Website URL (Optional) */}
            <div className="space-y-2">
              <Label htmlFor="companyUrl" className="text-base font-semibold text-gray-900">
                2. Company Website URL
                <span className="text-sm font-normal text-gray-500 ml-2">(Optional but recommended)</span>
              </Label>
              <Input
                id="companyUrl"
                type="url"
                value={companyUrl}
                onChange={(e) => setCompanyUrl(e.target.value)}
                className="h-10 border-2 border-gray-300 focus:border-violet-500"
                placeholder="https://company.com"
                disabled={isGenerating}
              />
              <p className="text-xs text-gray-500">Helps focus research on official company information</p>
            </div>

            {/* 3. LinkedIn Company/Profile URL (Optional) */}
            <div className="space-y-2">
              <Label htmlFor="linkedinUrl" className="text-base font-semibold text-gray-900">
                3. LinkedIn Company/Profile URL
                <span className="text-sm font-normal text-gray-500 ml-2">(Optional but recommended)</span>
              </Label>
              <Input
                id="linkedinUrl"
                type="url"
                value={linkedinUrl}
                onChange={(e) => setLinkedinUrl(e.target.value)}
                className="h-10 border-2 border-gray-300 focus:border-violet-500"
                placeholder="https://linkedin.com/company/snowflake-computing"
                disabled={isGenerating}
              />
              <p className="text-xs text-gray-500">For professional network and hiring pattern analysis</p>
            </div>

            {/* 4. CRM Context & Conversation Notes (Optional) */}
            <div className="space-y-2">
              <Label htmlFor="crmNotes" className="text-base font-semibold text-gray-900">
                4. CRM Context & Conversation Notes
                <span className="text-sm font-normal text-gray-500 ml-2">(Optional)</span>
              </Label>
              <Textarea
                id="crmNotes"
                value={crmNotes}
                onChange={(e) => setCrmNotes(e.target.value)}
                className="min-h-[100px] border-2 border-gray-300 focus:border-violet-500 resize-y"
                placeholder="Paste relevant notes from previous conversations, meetings, or CRM records that should guide our research focus..."
                maxLength={1000}
                disabled={isGenerating}
              />
              <div className="flex justify-between text-xs text-gray-500">
                <span>Previous conversations, meeting notes, or CRM context</span>
                <span>{crmNotes.length}/1000 characters</span>
              </div>
            </div>

            {/* 5. Organization/Division Focus (Optional) */}
            <div className="space-y-2">
              <Label htmlFor="organizationFocus" className="text-base font-semibold text-gray-900">
                5. Organization/Division Focus
                <span className="text-sm font-normal text-gray-500 ml-2">(Optional)</span>
              </Label>
              <Input
                id="organizationFocus"
                type="text"
                value={organizationFocus}
                onChange={(e) => setOrganizationFocus(e.target.value)}
                className="h-10 border-2 border-gray-300 focus:border-violet-500"
                placeholder="e.g., Cloud Division, Enterprise Sales, Security Group"
                disabled={isGenerating}
              />
              <p className="text-xs text-gray-500">Specific business unit or division to focus research on</p>
            </div>

            {/* 6. Geographic Location of Interest (Optional) */}
            <div className="space-y-2">
              <Label htmlFor="locationOfInterest" className="text-base font-semibold text-gray-900">
                6. Geographic Location of Interest
                <span className="text-sm font-normal text-gray-500 ml-2">(Optional)</span>
              </Label>
              <Input
                id="locationOfInterest"
                type="text"
                value={locationOfInterest}
                onChange={(e) => setLocationOfInterest(e.target.value)}
                className="h-10 border-2 border-gray-300 focus:border-violet-500"
                placeholder="e.g., San Francisco HQ, London office, EMEA region"
                disabled={isGenerating}
              />
              <p className="text-xs text-gray-500">Specific location or region (not always headquarters)</p>
            </div>

            {/* 7. News/Context Links (Optional) */}
            <div className="space-y-3">
              <Label className="text-base font-semibold text-gray-900">
                7. News/Context Links
                <span className="text-sm font-normal text-gray-500 ml-2">(Optional)</span>
              </Label>
              {contextLinks.map((link, index) => (
                <div key={index} className="flex gap-2">
                  <Input
                    type="url"
                    value={link}
                    onChange={(e) => updateContextLink(index, e.target.value)}
                    className="h-10 border-2 border-gray-300 focus:border-violet-500"
                    placeholder="https://news-article-or-press-release.com"
                    disabled={isGenerating}
                  />
                  {contextLinks.length > 1 && (
                    <Button
                      type="button"
                      variant="outline"
                      size="sm"
                      onClick={() => removeContextLink(index)}
                      className="px-2 border-2"
                      disabled={isGenerating}
                    >
                      <X className="h-4 w-4" />
                    </Button>
                  )}
                </div>
              ))}
              <Button
                type="button"
                variant="outline"
                size="sm"
                onClick={addContextLink}
                className="border-2 border-dashed border-gray-300 hover:border-violet-500 text-violet-600"
                disabled={isGenerating}
              >
                <Plus className="h-4 w-4 mr-1" />
                Add another link
              </Button>
              <p className="text-xs text-gray-500">Recent news, press releases, or events you want deeper analysis on</p>
            </div>

            {/* 8. Additional Research Direction (Optional) */}
            <div className="space-y-2">
              <Label htmlFor="additionalContext" className="text-base font-semibold text-gray-900">
                8. Additional Research Direction
                <span className="text-sm font-normal text-gray-500 ml-2">(Optional)</span>
              </Label>
              <Textarea
                id="additionalContext"
                value={additionalContext}
                onChange={(e) => setAdditionalContext(e.target.value)}
                className="min-h-[120px] border-2 border-gray-300 focus:border-violet-500 resize-y"
                placeholder="Tell our AI researchers anything else that would help create a better dossier - specific questions, areas of interest, competitive concerns, deal context, etc."
                maxLength={2000}
                disabled={isGenerating}
              />
              <div className="flex justify-between text-xs text-gray-500">
                <span>Specific questions, areas of interest, competitive concerns, deal context</span>
                <span>{additionalContext.length}/2000 characters</span>
              </div>
            </div>

            {/* Generate Button */}
            <div className="pt-6 border-t border-gray-200">
              <div className="text-center space-y-4">
                <Button
                  type="submit"
                  size="lg"
                  disabled={!companyName.trim() || isGenerating}
                  className="px-12 py-4 text-lg font-semibold bg-gradient-to-r from-violet-600 to-purple-600 hover:from-violet-700 hover:to-purple-700 text-white shadow-lg transition-all duration-200 disabled:opacity-50"
                >
                  {isGenerating ? (
                    <div className="flex items-center gap-3">
                      <div className="animate-spin rounded-full h-5 w-5 border-b-2 border-white"></div>
                      Generating Intelligence Dossier...
                    </div>
                  ) : (
                    <div className="flex items-center gap-2">
                      <Shield className="h-5 w-5" />
                      Generate Intelligence Dossier
                    </div>
                  )}
                </Button>
                <p className="text-sm text-gray-500">
                  Estimated time: 5-8 minutes for comprehensive analysis
                </p>
                {companyName.trim() && (
                  <p className="text-sm text-gray-600">
                    AI agents will analyze <strong>{companyName}</strong> across 20+ data sources
                  </p>
                )}
              </div>
            </div>
          </form>
        </CardContent>
      </Card>
    </div>
  );
};
                  type="text"
                  value={companyName}
                  onChange={(e) => {
                    setCompanyName(e.target.value);
                    setShowSuggestions(e.target.value.length > 0);
                  }}
                  onFocus={() => setShowSuggestions(companyName.length > 0)}
                  onBlur={() => setTimeout(() => setShowSuggestions(false), 200)}
                  // Task 2.2: Mobile touch optimizations
                  className={`${isMobile ? 'h-12 text-base py-3' : 'h-10 text-lg py-3'} pl-4 pr-12 border-2 border-slate-300 focus:border-blue-500`}
                  placeholder={isMobile ? "e.g., Microsoft" : "Enter target company name (e.g., Microsoft, Apple, Tesla)"}
                  autoComplete="organization"
                  autoCapitalize="words"
                  disabled={isGenerating}
                  required
                  aria-required="true"
                  aria-invalid={!companyName.trim() ? "true" : "false"}
                  aria-describedby={showSuggestions ? "company-suggestions" : undefined}
                />
                <Search 
                  className="absolute right-3 top-1/2 transform -translate-y-1/2 h-5 w-5 text-slate-400" 
                  aria-hidden="true"
                />
              </div>

              {/* Task 2.2: Mobile-Optimized Autocomplete Suggestions */}
              {showSuggestions && filteredCompanies.length > 0 && (
                <div 
                  className={`absolute z-10 w-full mt-1 bg-white border border-slate-200 rounded-md shadow-lg ${isMobile ? 'max-h-48 overflow-y-auto' : ''}`}
                  id="company-suggestions"
                  role="listbox"
                  aria-label="Company name suggestions"
                >
                  {filteredCompanies.map((company, index) => (
                    <button
                      key={index}
                      type="button"
                      className={`w-full px-4 ${isMobile ? 'py-3 text-base' : 'py-2 text-sm'} text-left hover:bg-slate-50 active:bg-slate-100 first:rounded-t-md last:rounded-b-md transition-colors ${isMobile ? 'min-h-[44px]' : ''}`}
                      onClick={() => {
                        setCompanyName(company);
                        setShowSuggestions(false);
                        // Task 2.2: Track mobile interaction
                        if (isMobile) {
                          performanceMonitor.trackMetric('mobile-suggestion-select', 1);
                        }
                      }}
                      role="option"
                      aria-selected="false"
                    >
                      <span className="text-slate-900">{company}</span>
                      <Badge 
                        variant="outline" 
                        className={`ml-2 ${isMobile ? 'text-xs' : ''}`}
                        aria-label="Previously searched company"
                      >
                        Previous
                      </Badge>
                    </button>
                  ))}
                </div>
              )}
            </div>

            {/* 🚨 CRITICAL: Solution Context Section */}
            <div className="border-t border-slate-200 pt-6">
              <h3 className="text-lg font-semibold text-slate-900 mb-4 flex items-center gap-2">
                <Zap className="h-5 w-5 text-amber-600" />
                Solution Context
              </h3>
              <p className="text-sm text-slate-600 mb-4">
                Define your vendor and product to generate solution-focused intelligence
              </p>

              {/* Vendor and Product Grid */}
              <div className={`grid ${isMobile ? 'grid-cols-1 gap-4' : 'md:grid-cols-2 gap-6'}`}>
                {/* Vendor Name */}
                <div>
                  <label 
                    htmlFor="vendor" 
                    className="block text-sm font-medium text-slate-700 mb-2"
                  >
                    Your Vendor/Company *
                  </label>
                  <div className="relative">
                    <Input
                      id="vendor"
                      type="text"
                      value={vendorName}
                      onChange={(e) => setVendorName(e.target.value)}
                      className={`${isMobile ? 'h-12 text-base' : 'h-10'} border-2 border-slate-300 focus:border-amber-500`}
                      placeholder="e.g. IBM, Microsoft, Dell, Adobe"
                      list="vendor-suggestions"
                      disabled={isGenerating}
                      required
                      aria-required="true"
                    />
                    <datalist id="vendor-suggestions">
                      {popularVendors.map(vendor => (
                        <option key={vendor} value={vendor} />
                      ))}
                    </datalist>
                  </div>
                </div>

                {/* Product Name */}
                <div>
                  <label 
                    htmlFor="product" 
                    className="block text-sm font-medium text-slate-700 mb-2"
                  >
                    Your Product/Solution *
                  </label>
                  <Input
                    id="product"
                    type="text"
                    value={productName}
                    onChange={(e) => setProductName(e.target.value)}
                    className={`${isMobile ? 'h-12 text-base' : 'h-10'} border-2 border-slate-300 focus:border-amber-500`}
                    placeholder="e.g. Apptio, Office365, PowerEdge"
                    disabled={isGenerating}
                    required
                    aria-required="true"
                  />
                </div>
              </div>

              {/* Industry and Pain Point */}
              <div className={`grid ${isMobile ? 'grid-cols-1 gap-4' : 'md:grid-cols-2 gap-6'} mt-4`}>
                {/* Industry */}
                <div>
                  <label 
                    htmlFor="industry" 
                    className="block text-sm font-medium text-slate-700 mb-2"
                  >
                    Target Company Industry *
                  </label>
                  <select
                    id="industry"
                    value={industry}
                    onChange={(e) => setIndustry(e.target.value)}
                    className={`w-full ${isMobile ? 'h-12 text-base' : 'h-10'} px-3 border-2 border-slate-300 focus:border-amber-500 rounded-md bg-white`}
                    disabled={isGenerating}
                    required
                    aria-required="true"
                  >
                    <option value="">Select industry...</option>
                    {industries.map(ind => (
                      <option key={ind} value={ind}>{ind}</option>
                    ))}
                  </select>
                </div>

                {/* Primary Pain Point */}
                <div>
                  <label 
                    htmlFor="painpoint" 
                    className="block text-sm font-medium text-slate-700 mb-2"
                  >
                    Primary Pain Point *
                  </label>
                  <Input
                    id="painpoint"
                    type="text"
                    value={primaryPainPoint}
                    onChange={(e) => setPrimaryPainPoint(e.target.value)}
                    className={`${isMobile ? 'h-12 text-base' : 'h-10'} border-2 border-slate-300 focus:border-amber-500`}
                    placeholder="Main challenge your solution addresses"
                    disabled={isGenerating}
                    required
                    aria-required="true"
                  />
                </div>
              </div>

              {/* Solution-Relevance Analysis Options */}
              <div className="mt-4 space-y-3">
                <h4 className="text-sm font-medium text-slate-700">Enhanced Analysis Options</h4>
                <div className={`grid ${isMobile ? 'grid-cols-1 gap-2' : 'md:grid-cols-3 gap-4'}`}>
                  <label className="flex items-center space-x-2 cursor-pointer">
                    <input
                      type="checkbox"
                      checked={competitorAnalysis}
                      onChange={(e) => setCompetitorAnalysis(e.target.checked)}
                      className="w-4 h-4 text-amber-600 rounded"
                      disabled={isGenerating}
                    />
                    <span className="text-sm text-slate-700">Competitor Analysis</span>
                  </label>
                  <label className="flex items-center space-x-2 cursor-pointer">
                    <input
                      type="checkbox"
                      checked={budgetIntelligence}
                      onChange={(e) => setBudgetIntelligence(e.target.checked)}
                      className="w-4 h-4 text-amber-600 rounded"
                      disabled={isGenerating}
                    />
                    <span className="text-sm text-slate-700">Budget Intelligence</span>
                  </label>
                  <label className="flex items-center space-x-2 cursor-pointer">
                    <input
                      type="checkbox"
                      checked={technologyStackFocus}
                      onChange={(e) => setTechnologyStackFocus(e.target.checked)}
                      className="w-4 h-4 text-amber-600 rounded"
                      disabled={isGenerating}
                    />
                    <span className="text-sm text-slate-700">Tech Stack Focus</span>
                  </label>
                </div>
              </div>
            </div>

            {/* Priority and Output Format */}
            <div className="grid md:grid-cols-2 gap-6">
              {/* Priority Selection */}
              <fieldset>
                <legend className="block text-sm font-medium text-slate-700 mb-3">
                  Analysis Priority
                </legend>
                <div className="space-y-2" role="radiogroup" aria-labelledby="priority-legend">
                  <label className="flex items-center space-x-3 cursor-pointer">
                    <input
                      type="radio"
                      name="priority"
                      value="standard"
                      checked={priority === 'standard'}
                      onChange={(e) => setPriority(e.target.value as 'standard' | 'express')}
                      className="w-4 h-4 text-blue-600"
                      disabled={isGenerating}
                      aria-describedby="standard-desc"
                    />
                    <div className="flex items-center gap-2">
                      <FileText className="h-4 w-4 text-slate-600" aria-hidden="true" />
                      <span className="text-slate-900">Standard (Thorough)</span>
                    </div>
                  </label>
                  <p id="standard-desc" className="text-xs text-slate-500 ml-7">Comprehensive analysis including market position, financial health, and growth potential</p>
                  
                  <label className="flex items-center space-x-3 cursor-pointer">
                    <input
                      type="radio"
                      name="priority"
                      value="express"
                      checked={priority === 'express'}
                      onChange={(e) => setPriority(e.target.value as 'standard' | 'express')}
                      className="w-4 h-4 text-blue-600"
                      disabled={isGenerating}
                      aria-describedby="express-desc"
                    />
                    <div className="flex items-center gap-2">
                      <Zap className="h-4 w-4 text-amber-500" aria-hidden="true" />
                      <span className="text-slate-900">Express (Faster)</span>
                    </div>
                  </label>
                  <p id="express-desc" className="text-xs text-slate-500 ml-7">Rapid analysis focusing on key business metrics and immediate insights</p>
                </div>
              </fieldset>

              {/* Output Format */}
              <fieldset>
                <legend className="block text-sm font-medium text-slate-700 mb-3">
                  Output Format
                </legend>
                <div className="space-y-2" role="radiogroup" aria-labelledby="format-legend">
                  {(['full', 'summary', 'custom'] as const).map((format) => (
                    <label key={format} className="flex items-center space-x-3 cursor-pointer">
                      <input
                        type="radio"
                        name="outputFormat"
                        value={format}
                        checked={outputFormat === format}
                        onChange={(e) => setOutputFormat(e.target.value as 'full' | 'summary' | 'custom')}
                        className="w-4 h-4 text-blue-600"
                        disabled={isGenerating}
                        aria-describedby={`${format}-format-desc`}
                      />
                      <span className="text-slate-900 capitalize" aria-hidden="true">
                        {format === 'full' ? '📄 Full Report' : 
                         format === 'summary' ? '📋 Executive Summary' : 
                         '⚙️ Custom Sections'}
                      </span>
                    </label>
                  ))}
                </div>
              </fieldset>
            </div>

            {/* Additional Context Section */}
            <Collapsible open={showContext} onOpenChange={setShowContext}>
              <CollapsibleTrigger asChild>
                <Button
                  type="button"
                  variant="outline"
                  className="w-full justify-between"
                  disabled={isGenerating}
                  aria-expanded={showContext}
                  aria-controls="context-content"
                  aria-label={`${showContext ? 'Hide' : 'Show'} additional context and focus areas`}
                >
                  <div className="flex items-center gap-2">
                    <Settings className="h-4 w-4" aria-hidden="true" />
                    Additional Context & Focus Areas
                  </div>
                  <ChevronDown className={`h-4 w-4 transition-transform ${showContext ? 'rotate-180' : ''}`} aria-hidden="true" />
                </Button>
              </CollapsibleTrigger>
              
              <CollapsibleContent className="mt-4" id="context-content">
                <div className="p-4 border border-slate-200 rounded-lg bg-slate-50" role="group" aria-labelledby="context-heading">
                  <p id="context-heading" className="text-sm text-slate-600 mb-3">
                    Select areas of focus to customize your intelligence gathering:
                  </p>
                  <div className="flex flex-wrap gap-2" role="group" aria-label="Focus area selection">
                    {contextSuggestions.map((suggestion) => (
                      <button
                        key={suggestion}
                        type="button"
                        onClick={() => toggleContext(suggestion)}
                        className={`px-3 py-1 rounded-full text-sm border transition-colors ${
                          selectedContext.includes(suggestion)
                            ? 'bg-blue-100 border-blue-300 text-blue-800'
                            : 'bg-white border-slate-300 text-slate-700 hover:border-slate-400'
                        }`}
                        disabled={isGenerating}
                        aria-pressed={selectedContext.includes(suggestion)}
                        aria-label={`${selectedContext.includes(suggestion) ? 'Remove' : 'Add'} ${suggestion} focus area`}
                      >
                        {suggestion}
                      </button>
                    ))}
                  </div>
                  {selectedContext.length > 0 && (
                    <div className="mt-3 pt-3 border-t border-slate-200">
                      <p className="text-sm text-slate-600 mb-2" id="selected-focus-areas">Selected focus areas:</p>
                      <div className="flex flex-wrap gap-1" role="group" aria-labelledby="selected-focus-areas">
                        {selectedContext.map((context) => (
                          <Badge key={context} variant="default" className="text-xs" aria-label={`Selected focus area: ${context}`}>
                            {context}
                          </Badge>
                        ))}
                      </div>
                    </div>
                  )}
                </div>
              </CollapsibleContent>
            </Collapsible>

            {/* Enhanced Submit Button with Solution-Relevance Validation */}
            <div className="text-center pt-4">
              {/* Required Field Validation Helper */}
              {(!companyName.trim() || !vendorName.trim() || !productName.trim() || 
                !industry.trim() || !primaryPainPoint.trim()) && !isGenerating && (
                <div className="mb-4 p-3 bg-amber-50 border border-amber-200 rounded-lg">
                  <p className="text-sm text-amber-800 font-medium mb-1">Required Information Missing:</p>
                  <ul className="text-xs text-amber-700 space-y-1">
                    {!companyName.trim() && <li>• Target company name</li>}
        </CardContent>
      </Card>
    </div>
  );
};